.tabbar { position: fixed; z-index: 99; left: 0; right: 0; bottom: 0; height: calc(160rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; display: flex; align-items: center; background: #fbfaf7; border-top: 1rpx solid #e5e3dc; }
/* The floating circle ends 52rpx below the border; all icons start at 68rpx. */
.tab { flex: 1; display: flex; height: 160rpx; box-sizing: border-box; padding-top: 68rpx; flex-direction: column; align-items: center; justify-content: flex-start; gap: 6rpx; color: #777; font-size: 22rpx; line-height: 30rpx; }
.active { color: #1769ff; font-weight: 650; }.icon { display: block; height: 38rpx; font-size: 36rpx; line-height: 38rpx; }
.fab { position: absolute; left: 50%; top: -52rpx; transform: translateX(-50%); width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 50%; background: #1769ff; color: #fff; font-size: 58rpx; line-height: 1; font-weight: 300; box-shadow: 0 14rpx 34rpx rgba(23,105,255,.28); }
