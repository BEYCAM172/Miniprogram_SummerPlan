page { background: #f8f7f3; color: #101722; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
button { font-weight: 600; } button::after { border: 0; }
.page { min-height: 100vh; box-sizing: border-box; padding: calc(env(safe-area-inset-top) + 84rpx) 36rpx 180rpx; }
.eyebrow { color: #69707a; font-size: 26rpx; letter-spacing: 2rpx; }
.title { margin-top: 10rpx; font-size: 68rpx; line-height: 1.1; font-weight: 800; letter-spacing: -2rpx; }
.section-title { font-size: 38rpx; font-weight: 750; }
.muted { color: #858a92; } .blue { color: #1769ff; }
.card { background: #fff; border: 1rpx solid #e8e6df; border-radius: 24rpx; padding: 28rpx; }
.primary { background: #1769ff; color: #fff; border-radius: 18rpx; height: 96rpx; line-height: 96rpx; font-size: 30rpx; }
.secondary { background: #eaf1ff; color: #1769ff; border-radius: 18rpx; height: 88rpx; line-height: 88rpx; }
.danger { background: #fff0ee; color: #d83b2d; }
.field { margin-bottom: 30rpx; } .label { display: block; margin-bottom: 14rpx; color: #626872; font-size: 26rpx; }
.input { box-sizing: border-box; width: 100%; height: 92rpx; padding: 0 24rpx; background: #fff; border: 1rpx solid #dedcd5; border-radius: 16rpx; }
.textarea { height: 160rpx; padding-top: 22rpx; } .empty { padding: 80rpx 20rpx; text-align: center; color: #979ba1; }
