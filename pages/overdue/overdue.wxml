<view class="page overdue-page">
  <view class="nav"><text bindtap="back">‹ 返回</text><text class="nav-title">逾期任务</text><text class="nav-space">返回</text></view>
  <view class="title">重新安排</view>
  <view class="intro">这里只显示假期内、今天以前尚未完成的任务。</view>
  <view wx:if="{{!items.length}}" class="empty-card card"><text class="empty-title">已经全部处理完了</text><text class="muted">没有等待重新安排的任务</text></view>
  <view wx:for="{{items}}" wx:key="key" class="overdue-item card">
    <view class="item-date">{{item.dateText}}</view>
    <view class="item-title">{{item.title}}</view>
    <view wx:if="{{item.note}}" class="item-note">{{item.note}}</view>
    <view class="actions">
      <view class="action secondary-action" data-id="{{item._id}}" data-day="{{item.occurrenceDate}}" bindtap="chooseDate">选择日期</view>
      <view class="action primary-action" data-id="{{item._id}}" data-day="{{item.occurrenceDate}}" bindtap="moveToday">移到今天</view>
    </view>
  </view>
  <view wx:if="{{movingId}}" class="modal-mask" catchtap="cancelPicker">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">选择新的安排日期</view>
      <picker mode="date" value="{{moveDate}}" start="{{vacation.startDate}}" end="{{vacation.endDate}}" bindchange="onMoveDate"><view class="date-value">{{moveDate}} ›</view></picker>
      <view class="modal-actions"><view bindtap="cancelPicker">取消</view><view class="confirm" bindtap="confirmMove">确认调整</view></view>
    </view>
  </view>
</view>
