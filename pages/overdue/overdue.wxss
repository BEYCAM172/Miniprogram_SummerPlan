.overdue-page { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.nav { display:flex; align-items:center; justify-content:space-between; height:72rpx; color:#1769ff; font-size:26rpx; }
.nav-title { color:#101722; font-weight:700; }.nav-space { visibility:hidden; }
.intro { margin-top:22rpx; color:#7e848c; font-size:26rpx; line-height:1.6; }
.smart-card { margin-top:30rpx; padding:30rpx; color:#fff; background:linear-gradient(135deg,#1769ff,#5947e8); border-radius:26rpx; box-shadow:0 18rpx 42rpx rgba(23,105,255,.2); }.smart-label { color:#cbdcff; font-size:19rpx; letter-spacing:2rpx; }.smart-title { margin-top:10rpx; font-size:32rpx; font-weight:750; }.smart-desc { margin-top:10rpx; color:#e3ebff; font-size:23rpx; line-height:1.5; }.smart-button { margin-top:24rpx; height:76rpx; line-height:76rpx; text-align:center; color:#1769ff; background:#fff; border-radius:16rpx; font-size:27rpx; font-weight:750; }.disabled { opacity:.48; pointer-events:none; }
.overdue-item { margin-top:24rpx; }.item-date { color:#db6b18; font-size:23rpx; font-weight:650; }
.item-title { margin-top:14rpx; font-size:31rpx; font-weight:700; }.item-note { margin-top:8rpx; color:#858a92; font-size:24rpx; }
.actions { display:flex; gap:18rpx; margin-top:26rpx; }.action { flex:1; height:72rpx; line-height:72rpx; text-align:center; border-radius:14rpx; font-size:25rpx; font-weight:650; }
.secondary-action { color:#1769ff; background:#edf3ff; }.primary-action { color:#fff; background:#1769ff; }
.empty-card { margin-top:42rpx; padding:70rpx 30rpx; text-align:center; }.empty-title { display:block; margin-bottom:12rpx; font-size:30rpx; font-weight:700; }
.modal-mask { position:fixed; inset:0; z-index:200; display:flex; align-items:flex-end; background:rgba(16,23,34,.3); }
.modal-card { width:100%; padding:34rpx 36rpx calc(34rpx + env(safe-area-inset-bottom)); background:#fff; border-radius:30rpx 30rpx 0 0; }
.modal-title { font-size:31rpx; font-weight:750; }.date-value { margin-top:28rpx; height:90rpx; line-height:90rpx; padding:0 24rpx; background:#f4f3ef; border-radius:16rpx; font-size:28rpx; }
.modal-actions { display:flex; justify-content:flex-end; gap:40rpx; margin-top:30rpx; color:#737981; font-size:27rpx; }.confirm { color:#1769ff; font-weight:700; }
.preview-card { width:100%; max-height:82vh; padding:36rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:#fff; border-radius:30rpx 30rpx 0 0; }.preview-head { display:flex; align-items:flex-start; justify-content:space-between; }.preview-sub { margin-top:8rpx; color:#858a92; font-size:23rpx; }.close { padding:0 8rpx; color:#8c9198; font-size:46rpx; line-height:1; }.limit-note { margin-top:22rpx; padding:18rpx; color:#996326; background:#fff6e9; border-radius:14rpx; font-size:22rpx; line-height:1.45; }.preview-list { max-height:48vh; margin-top:24rpx; }.preview-row { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #eceae5; }.preview-count { flex:none; width:58rpx; height:58rpx; line-height:58rpx; text-align:center; color:#1769ff; background:#edf3ff; border-radius:16rpx; font-size:26rpx; font-weight:750; }.preview-copy { min-width:0; margin-left:20rpx; }.preview-date { font-size:27rpx; font-weight:700; }.preview-summary { margin-top:7rpx; overflow:hidden; color:#8a8f97; font-size:22rpx; white-space:nowrap; text-overflow:ellipsis; }.preview-actions { display:flex; gap:18rpx; margin-top:28rpx; }.cancel-action,.batch-action { height:82rpx; line-height:82rpx; text-align:center; border-radius:16rpx; font-size:27rpx; font-weight:700; }.cancel-action { width:30%; color:#6f747c; background:#efeee9; }.batch-action { flex:1; color:#fff; background:#1769ff; }
