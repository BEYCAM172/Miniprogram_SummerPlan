.editor { padding-bottom: 70rpx; }.nav { display: flex; align-items: center; justify-content: space-between; height: 80rpx; color: #1769ff; font-size: 27rpx; }.nav-title { color: #101722; font-weight: 700; }.save { font-weight: 700; }.first { margin-top: 46rpx; }.title-input { height: 112rpx; font-size: 34rpx; font-weight: 650; }
.form-card { margin-top: 36rpx; padding: 0 26rpx; background: #fff; border: 1rpx solid #e1dfd8; border-radius: 20rpx; }.form-row { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #eceae5; font-size: 28rpx; }.form-row:last-child { border: 0; }.value { color: #747981; }.inline { display: flex; align-items: center; gap: 18rpx; }.clear { color: #1769ff; font-size: 23rpx; }
.weekday-picker,.note { margin-top: 34rpx; }.week-buttons { display: flex; justify-content: space-between; }.week-button { width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center; background: #e9e8e3; border-radius: 50%; color: #666c74; }.week-button.selected { color: #fff; background: #1769ff; font-weight: 700; }.primary { margin-top: 44rpx; }.delete { margin-top: 18rpx; color: #d83b2d; background: transparent; font-size: 27rpx; }
