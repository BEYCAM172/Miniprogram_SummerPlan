.editor { padding-bottom: 70rpx; }.nav { display: flex; align-items: center; justify-content: space-between; height: 80rpx; color: #1769ff; font-size: 27rpx; }.nav-title { color: #101722; font-weight: 700; }.save { font-weight: 700; }.first { margin-top: 46rpx; }.title-input { height: 112rpx; font-size: 32rpx; font-weight: 650; }.field { margin-top: 34rpx; }
.form-row { margin-top: 34rpx; min-height: 96rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; background: #fff; border: 1rpx solid #e1dfd8; border-radius: 18rpx; font-size: 28rpx; }.value { color: #747981; }.colors { display: flex; gap: 28rpx; }.color { width: 64rpx; height: 64rpx; border-radius: 50%; box-sizing: border-box; }.color.selected { border: 7rpx solid #fff; outline: 3rpx solid #101722; }.primary { margin-top: 52rpx; }.delete { margin-top: 18rpx; color: #d83b2d; background: transparent; font-size: 27rpx; }
