<view class="page">
  <view class="eyebrow">SUMMER OVERVIEW</view><view class="title">计划</view>
  <view class="segmented"><view class="segment {{tab === 'calendar' ? 'active' : ''}}" data-tab="calendar" bindtap="switchView">日历</view><view class="segment {{tab === 'goals' ? 'active' : ''}}" data-tab="goals" bindtap="switchView">目标</view></view>
  <block wx:if="{{tab === 'calendar'}}">
    <view class="month-head"><button bindtap="previousMonth">‹</button><text>{{monthLabel}}</text><button bindtap="nextMonth">›</button></view>
    <view class="calendar card">
      <view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view>
      <view wx:for="{{cells}}" wx:key="value" class="cell {{!item.inMonth ? 'outside' : ''}} {{!item.inVacation ? 'disabled' : ''}} {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}}" data-date="{{item.value}}" bindtap="selectDate">
        <text>{{item.number}}</text><view wx:if="{{item.count}}" class="task-dot {{item.allDone ? 'complete' : ''}}"></view>
      </view>
    </view>
    <view class="list-head"><view><text class="section-title">{{selectedDate}}</text><text class="count">{{tasks.length}} 项</text></view><button bindtap="addTask">＋ 添加</button></view>
    <view wx:if="{{!tasks.length}}" class="empty">这天还没有计划</view>
    <view wx:for="{{tasks}}" wx:key="_id" class="task-row" data-id="{{item._id}}" bindtap="editTask">
      <view catchtap="toggle" class="check {{item.done ? 'checked' : ''}}" data-id="{{item._id}}" data-day="{{item.occurrenceDate}}" data-done="{{item.done}}">{{item.done ? '✓' : ''}}</view>
      <view class="task-copy"><text class="task-title {{item.done ? 'done' : ''}}">{{item.title}}</text><text class="task-meta">{{item.time || '全天'}}{{item.repeat.type !== 'once' ? ' · 重复' : ''}}</text></view><text class="chevron">›</text>
    </view>
  </block>
  <block wx:else>
    <view class="goal-head"><text class="muted">把长期想法拆成每天能完成的小事</text><button bindtap="addGoal">＋ 新目标</button></view>
    <view wx:if="{{!goals.length}}" class="empty">还没有暑期目标</view>
    <view wx:for="{{goals}}" wx:key="_id" class="goal card" data-id="{{item._id}}" bindtap="editGoal">
      <view class="goal-accent" style="background: {{item.color}}"></view><view class="goal-content"><view class="goal-title">{{item.title}}</view><view class="goal-meta">截止 {{item.deadlineText}} · 截至今天 {{item.progress.done}}/{{item.progress.total}} 项</view><view class="progress"><view style="width: {{item.progress.percent}}%; background: {{item.color}}"></view></view></view><text class="chevron">›</text>
    </view>
  </block>
</view>
