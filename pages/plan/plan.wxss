.segmented { display: flex; margin-top: 42rpx; padding: 6rpx; background: #ebeae5; border-radius: 16rpx; }.segment { flex: 1; padding: 18rpx; text-align: center; color: #73777e; border-radius: 12rpx; font-size: 27rpx; }.segment.active { color: #101722; background: #fff; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.04); }
.month-head { margin: 38rpx 0 20rpx; display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 700; }.month-head button { margin: 0; width: 70rpx; height: 64rpx; line-height: 58rpx; padding: 0; background: transparent; color: #1769ff; font-size: 46rpx; }
.calendar { display: grid; grid-template-columns: repeat(7, 1fr); padding: 20rpx 12rpx; }.weekday { height: 50rpx; text-align: center; color: #95989e; font-size: 22rpx; }.cell { height: 82rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 27rpx; }.cell.outside { color: #c1c2c3; }.cell.selected { color: #fff; background: #1769ff; font-weight: 700; }.cell.today:not(.selected) { color: #1769ff; font-weight: 800; }.task-dot { margin-top: 7rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #1769ff; }.task-dot.complete { background: #58a97d; }.selected .task-dot { background: #fff; }
.list-head,.goal-head { display: flex; align-items: center; justify-content: space-between; margin-top: 42rpx; }.list-head button,.goal-head button { margin: 0; padding: 0 12rpx; background: transparent; color: #1769ff; font-size: 26rpx; }.count { margin-left: 16rpx; color: #96999f; font-size: 24rpx; }
.task-row { min-height: 112rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e1e0db; }.check { flex: none; width: 46rpx; height: 46rpx; line-height: 42rpx; padding: 0; margin: 0 24rpx 0 0; border: 3rpx solid #1769ff; border-radius: 50%; color: #fff; background: transparent; }.check.checked { background: #96999e; border-color: #96999e; }.task-copy { flex: 1; display: flex; flex-direction: column; }.task-title { font-size: 29rpx; font-weight: 650; }.task-title.done { color: #96999e; text-decoration: line-through; }.task-meta,.goal-meta { margin-top: 8rpx; color: #91959b; font-size: 23rpx; }.chevron { color: #a1a4a8; font-size: 40rpx; }
.goal-head { margin: 42rpx 0 24rpx; }.goal-head .muted { width: 65%; font-size: 25rpx; }.goal { position: relative; display: flex; align-items: center; margin-bottom: 20rpx; overflow: hidden; }.goal-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 8rpx; }.goal-content { flex: 1; padding-left: 10rpx; }.goal-title { font-size: 31rpx; font-weight: 700; }.progress { margin-top: 22rpx; width: 100%; height: 7rpx; border-radius: 5rpx; background: #e7e7e4; overflow: hidden; }.progress view { height: 100%; border-radius: inherit; }
.cell.disabled { opacity: .28; }
