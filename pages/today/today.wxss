.topline,.summer-progress,.section-head,.goal-top { display: flex; align-items: center; justify-content: space-between; }.sync { color: #63806f; font-size: 22rpx; }.sync.offline { color: #d47629; }
.date-label { margin-top: 16rpx; font-size: 30rpx; font-weight: 650; }.summer-progress { margin-top: 64rpx; font-size: 28rpx; }.strong { font-size: 36rpx; font-weight: 800; }
.bar { margin-top: 18rpx; height: 8rpx; overflow: hidden; border-radius: 8rpx; background: #e3e3e1; }.bar-fill { height: 100%; border-radius: inherit; background: #1769ff; transition: width .35s; }
.overdue { display: flex; justify-content: space-between; align-items: center; margin-top: 30rpx; padding: 22rpx 24rpx; background: #fff7ec; border-color: #f2dfc4; font-size: 26rpx; }.overdue-count { color: #db6b18; font-size: 34rpx; font-weight: 800; }.overdue-hint { color: #9b7653; font-size: 22rpx; }
.week { margin-top: 34rpx; width: 100%; white-space: nowrap; border-top: 1rpx solid #deddd8; padding-top: 26rpx; }.day { display: inline-flex; width: 14.28%; min-width: 86rpx; height: 124rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 18rpx; box-sizing: border-box; }.weekday { color: #7f848b; font-size: 24rpx; }.number { margin-top: 10rpx; font-size: 32rpx; font-weight: 650; }.day.selected { color: #fff; background: #1769ff; }.selected .weekday { color: #dce8ff; }.dot { margin-top: 8rpx; width: 7rpx; height: 7rpx; border-radius: 50%; }.dot.visible { background: #1769ff; }.selected .dot.visible { background: #fff; }
.section-head { margin-top: 48rpx; }.big-number { font-size: 42rpx; font-weight: 800; }.timeline { margin-top: 22rpx; }.task { min-height: 104rpx; display: flex; align-items: center; border-bottom: 1rpx solid #e1e0db; }.time { width: 105rpx; color: #555c65; font-size: 27rpx; font-variant-numeric: tabular-nums; }.check { width: 48rpx; height: 48rpx; padding: 0; line-height: 44rpx; margin: 0 28rpx 0 0; border: 3rpx solid #1769ff; background: transparent; color: #fff; border-radius: 50%; font-size: 26rpx; }.check.checked { background: #a6a8ac; border-color: #a6a8ac; }.task-main { flex: 1; display: flex; flex-direction: column; padding: 22rpx 0; }.task-title { font-size: 30rpx; font-weight: 620; }.task-note { margin-top: 7rpx; color: #92969c; font-size: 23rpx; }.task.done .task-title { color: #92959a; text-decoration: line-through; }
.goals-section { margin-top: 52rpx; }.goal-section-head { display:flex; align-items:center; justify-content:space-between; }.goal-card { margin-top: 20rpx; }.goal-top { display:flex; align-items:center; justify-content:space-between; color: #6f747b; font-size: 25rpx; }.goal-name { color:#101722; font-size: 30rpx; font-weight: 650; }.bar.small { margin-top: 20rpx; height: 7rpx; }.add-goal { margin-top: 48rpx; background: transparent; color: #1769ff; font-size: 27rpx; }
.picker-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(16,23,34,.28); }.picker-card { padding: 34rpx 44rpx; color: #1769ff; background: #fff; border-radius: 20rpx; font-size: 28rpx; font-weight: 650; box-shadow: 0 20rpx 60rpx rgba(0,0,0,.15); }
.check { flex: none; box-sizing: border-box; text-align: center; }
.task-more { flex: none; padding: 30rpx 4rpx 30rpx 24rpx; color: #8c9198; font-size: 24rpx; letter-spacing: 2rpx; }
.day.disabled { opacity: .3; }.check.checked { animation: check-pop .24s ease-out; }
@keyframes check-pop { 0% { transform: scale(.72); } 70% { transform: scale(1.12); } 100% { transform: scale(1); } }
