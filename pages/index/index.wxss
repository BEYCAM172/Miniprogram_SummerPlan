page { background: #1769ff; }
.splash { height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; }
.mark { width: 116rpx; height: 116rpx; line-height: 116rpx; text-align: center; border: 2rpx solid rgba(255,255,255,.45); border-radius: 32rpx; font-size: 58rpx; font-weight: 800; }
.brand { margin-top: 32rpx; font-size: 40rpx; font-weight: 750; letter-spacing: 4rpx; }
.message { margin-top: 18rpx; color: rgba(255,255,255,.72); font-size: 24rpx; }
.pulse { margin-top: 44rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: #fff; animation: pulse 1s infinite alternate; }
@keyframes pulse { from { opacity: .25; transform: scale(.8); } to { opacity: 1; transform: scale(1.4); } }
