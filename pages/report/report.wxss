.report-page { padding-bottom:calc(70rpx + env(safe-area-inset-bottom)); background:#f4f3ef; }.nav { display:flex; align-items:center; justify-content:space-between; height:72rpx; color:#1769ff; font-size:26rpx; }.nav-title { color:#101722; font-weight:700; }.nav-space { visibility:hidden; }
.report-hero { position:relative; margin-top:26rpx; padding:38rpx 34rpx 34rpx; overflow:hidden; color:#fff; background:linear-gradient(145deg,#1769ff,#6f86f7); border-radius:30rpx; box-shadow:0 24rpx 54rpx rgba(23,105,255,.22); }.hero-orbit { position:absolute; border:1rpx solid rgba(255,255,255,.22); border-radius:50%; }.orbit-one { right:-80rpx; top:-100rpx; width:330rpx; height:330rpx; }.orbit-two { right:30rpx; top:15rpx; width:170rpx; height:170rpx; }.hero-kicker { position:relative; color:#dbe6ff; font-size:20rpx; letter-spacing:3rpx; }.hero-name { position:relative; margin-top:13rpx; color:#eef3ff; font-size:25rpx; }.hero-score { position:relative; margin-top:22rpx; font-size:112rpx; line-height:1; font-weight:800; letter-spacing:-6rpx; }.score-unit { margin-left:7rpx; color:#dbe6ff; font-size:44rpx; letter-spacing:0; }.hero-caption { position:relative; margin-top:12rpx; color:#e3eaff; font-size:23rpx; }.hero-progress { position:relative; height:8rpx; margin-top:28rpx; overflow:hidden; background:rgba(255,255,255,.25); border-radius:6rpx; }.hero-progress view { height:100%; background:#fff; border-radius:inherit; }.hero-date { position:relative; margin-top:16rpx; color:#d5e0ff; font-size:20rpx; }
.metric-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:22rpx; }.metric-card { display:flex; flex-direction:column; padding:24rpx 20rpx; background:#fff; border:1rpx solid #e5e2db; border-radius:20rpx; }.metric-value { font-size:44rpx; font-weight:800; }.metric-label { margin-top:8rpx; color:#8a8f96; font-size:21rpx; }.insight-card { margin-top:24rpx; }.insight-label { color:#1769ff; font-size:21rpx; font-weight:700; letter-spacing:1rpx; }.insight-text { margin-top:14rpx; font-size:28rpx; line-height:1.7; font-weight:580; }
.section-head { display:flex; align-items:baseline; justify-content:space-between; margin-top:50rpx; }.section-head .muted { font-size:22rpx; }.trend-card { display:flex; align-items:flex-end; height:300rpx; margin-top:20rpx; padding:30rpx 18rpx 22rpx; }.trend-column { flex:1; display:flex; height:100%; min-width:0; flex-direction:column; align-items:center; }.trend-value { color:#7d838c; font-size:18rpx; }.trend-track { position:relative; flex:1; width:32rpx; margin:13rpx 0; overflow:hidden; background:#ecebe6; border-radius:16rpx; }.trend-fill { position:absolute; right:0; bottom:0; left:0; min-height:6rpx; background:linear-gradient(180deg,#6194ff,#1769ff); border-radius:16rpx; }.trend-label { color:#8e9298; font-size:18rpx; white-space:nowrap; }.empty-section { margin-top:20rpx; padding:60rpx 24rpx; text-align:center; color:#93979d; font-size:24rpx; }
.highlight-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:24rpx; }.highlight-card { min-height:180rpx; padding:27rpx; box-sizing:border-box; background:#fff; border:1rpx solid #e5e2db; border-radius:22rpx; }.highlight-kicker { color:#1769ff; font-size:18rpx; letter-spacing:2rpx; }.highlight-value { margin-top:20rpx; overflow:hidden; font-size:28rpx; font-weight:750; white-space:nowrap; text-overflow:ellipsis; }.highlight-desc { margin-top:10rpx; color:#8a8f96; font-size:21rpx; }.achievement-head { margin-top:52rpx; }.achievement-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:20rpx; }.achievement { min-height:220rpx; padding:25rpx; box-sizing:border-box; color:#979ba1; background:#e9e8e3; border:1rpx solid #e0ded7; border-radius:22rpx; }.achievement.unlocked { color:#101722; background:#fff; border-color:#dbe5ff; box-shadow:0 12rpx 30rpx rgba(23,105,255,.08); }.achievement-icon { width:56rpx; height:56rpx; line-height:56rpx; text-align:center; color:#a3a6aa; background:#dcdad4; border-radius:18rpx; font-size:29rpx; font-weight:750; }.unlocked .achievement-icon { color:#fff; background:#1769ff; }.achievement-name { margin-top:20rpx; font-size:26rpx; font-weight:700; }.achievement-desc { margin-top:8rpx; font-size:20rpx; line-height:1.45; }.achievement-status { margin-top:15rpx; color:#a1a4a8; font-size:19rpx; }.unlocked .achievement-status { color:#1769ff; font-weight:650; }
.share-actions { display:flex; gap:18rpx; margin-top:36rpx; }.copy-action,.share-action { flex:1; height:88rpx; line-height:88rpx; box-sizing:border-box; text-align:center; border-radius:17rpx; font-size:26rpx; font-weight:700; }.copy-action { color:#1769ff; background:#e5edff; }.share-action { margin:0; padding:0; color:#fff; background:#1769ff; }
