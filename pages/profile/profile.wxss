.hero { margin-top: 44rpx; }
.hero-top { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 700; }
.percent { font-size: 42rpx; font-weight: 800; }
.bar { width: 100%; height: 8rpx; margin: 24rpx 0; overflow: hidden; border-radius: 8rpx; background: #e4e3df; }
.bar-fill { height: 100%; background: #1769ff; }
.range { color: #858a92; font-size: 23rpx; }
.metrics { display: flex; margin: 42rpx 0 30rpx; }
.metrics > view { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; text-align:center; }
.metric-value { min-height:56rpx; line-height:56rpx; font-size:43rpx; font-weight:800; font-variant-numeric:tabular-nums; }
.metric-label { width:100%; margin-top:8rpx; color:#8d9197; font-size:22rpx; line-height:32rpx; text-align:center; }
.report-entry { display:flex; align-items:center; justify-content:space-between; margin-bottom:50rpx; padding:30rpx; color:#101722; background:linear-gradient(135deg,#f8faff,#e9f1ff); border:1rpx solid #d9e5ff; border-radius:24rpx; box-shadow:0 14rpx 32rpx rgba(23,105,255,.08); }.report-kicker { color:#1769ff; font-size:18rpx; letter-spacing:2rpx; }.report-title { margin-top:10rpx; font-size:30rpx; font-weight:750; }.report-desc { margin-top:8rpx; color:#748096; font-size:21rpx; }.report-arrow { width:62rpx; height:62rpx; line-height:62rpx; text-align:center; color:#1769ff; background:#fff; border:1rpx solid #cbdcff; border-radius:50%; font-size:29rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; }
.section-head .muted { font-size: 22rpx; }
.heat { display: flex; flex-wrap: wrap; margin-top: 22rpx; padding: 20rpx; }
.heat-cell { width: 12.28%; height: 42rpx; margin: 1%; box-sizing: border-box; border-radius: 7rpx; background: #e9e8e3; }
.heat-cell.level-1 { background: #bcd1ff; }.heat-cell.level-2 { background: #6b9cff; }.heat-cell.level-3 { background: #1769ff; }.heat-cell.blank { opacity: 0; }
.sync-card { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.sync-copy { flex:1; min-width:0; padding-right:18rpx; }
.sync-title { font-size: 28rpx; font-weight: 700; }.sync-detail { margin-top: 8rpx; color: #92969c; font-size: 22rpx; }
.pending-badge { display:inline-block; min-width:32rpx; height:32rpx; margin-left:10rpx; padding:0 7rpx; box-sizing:border-box; line-height:32rpx; text-align:center; color:#fff; background:#db6b18; border-radius:16rpx; font-size:19rpx; }
.sync-error { margin-top:8rpx; color:#c65e18; font-size:21rpx; line-height:1.45; }
.sync-card button { margin: 0; padding: 0 16rpx; color: #1769ff; background: transparent; font-size: 24rpx; }
.settings { margin-top: 24rpx; padding: 0 26rpx; }
.settings > view { display: flex; justify-content: space-between; padding: 30rpx 0; border-bottom: 1rpx solid #eceae5; font-size: 27rpx; }
.settings > view:last-child { border: 0; }.settings > view > text:last-child { color: #92969c; }.settings .red { color: #d83b2d; }
