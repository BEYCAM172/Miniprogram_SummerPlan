<view class="page">
  <view class="eyebrow">YOUR SUMMER</view>
  <view class="title">我的暑假</view>
  <view class="hero card">
    <view class="hero-top"><text>{{vacation.name}}</text><text class="blue percent">{{progress.percent}}%</text></view>
    <view class="bar"><view class="bar-fill" style="width: {{progress.percent}}%"></view></view>
    <view class="range">{{vacation.startDate}} — {{vacation.endDate}}</view>
  </view>
  <view class="metrics">
    <view><text class="metric-value">{{summary.done}}</text><text class="metric-label">完成任务</text></view>
    <view><text class="metric-value">{{summary.percent}}%</text><text class="metric-label">截至今日完成率</text></view>
    <view><text class="metric-value">{{summary.streak}}</text><text class="metric-label">连续天数</text></view>
  </view>
  <view class="report-entry" bindtap="viewReport">
    <view><view class="report-kicker">MY SUMMER REPORT</view><view class="report-title">查看我的暑期报告</view><view class="report-desc">行动趋势、最佳一天与 6 枚暑期成就</view></view><view class="report-arrow">↗</view>
  </view>
  <view class="section-head"><text class="section-title">完成热力图</text><text class="muted">按日期点击查看</text></view>
  <view class="heat card">
    <view wx:for="{{heatmap}}" wx:key="key" class="heat-cell level-{{item.level}} {{item.blank ? 'blank' : ''}}" data-label="{{item.label}}" data-count="{{item.count}}" data-total="{{item.total}}" bindtap="showHeat"></view>
  </view>
  <view class="sync-card card">
    <view class="sync-copy"><view class="sync-title">{{syncText}}<text wx:if="{{pendingCount}}" class="pending-badge">{{pendingCount}}</text></view><view class="sync-detail">{{syncDetail}}</view><view wx:if="{{syncError}}" class="sync-error">{{syncError}}</view></view>
    <button loading="{{syncing}}" bindtap="retry">重新同步</button>
  </view>
  <view class="settings card">
    <view bindtap="editVacation"><text>假期名称与日期</text><text>›</text></view>
    <view bindtap="restore"><text>恢复示例计划</text><text>›</text></view>
    <view class="red" bindtap="clear"><text>清空所有数据</text><text>›</text></view>
  </view>
</view>
